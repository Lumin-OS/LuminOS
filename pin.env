#!/hint/bash
# LuminOS build pins.
#
# This file is the ONLY place a version-bearing input is declared. Everything
# else in the build derives from it, so bumping the snapshot here is the whole
# "update LuminOS to current Arch" operation.
#
# Why an Arch Linux Archive snapshot instead of a live mirror: archiso has no
# per-package version pinning, so the only way to make `packages.x86_64`
# resolve to the same closure next week is to point pacman at a frozen daily
# snapshot of core/extra/multilib. A live mirrorlist makes the ISO a
# mirror-of-the-day lottery, which is exactly how this profile rotted between
# February 2024 and now.
#
# To bump: pick a newer date that exists under
#   https://archive.archlinux.org/repos/<YYYY>/<MM>/<DD>/
# update ARCH_SNAPSHOT and SOURCE_DATE_EPOCH together, then re-run ./build.sh
# and re-verify the boot. Do not bump one without the other.

# Frozen Arch repo snapshot (YYYY/MM/DD) used for BOTH the builder container's
# own toolchain and the packages that land in the image.
ARCH_SNAPSHOT="2026/09/25"

# Must correspond to 00:00:00 UTC on ARCH_SNAPSHOT.
#   date -u -d '2026-09-25 00:00:00' +%s
# archiso feeds this into iso_version and iso_label, so pinning it keeps the
# artifact name and volume label stable across rebuilds.
SOURCE_DATE_EPOCH="1790294400"

# Builder base image, pinned by digest. The container is then upgraded down to
# ARCH_SNAPSHOT, so this digest only fixes the starting point; it is pinned
# anyway so a rebuild cannot start from a different glibc/pacman than the one
# this was verified against.
BUILDER_IMAGE="archlinux@sha256:f3691b4dde62ba4c4b6f0ae2c1fbf28e8c0c8c4b9a35c7e06dc1f70e21aa29f6"

# Builder-side toolchain. These are host tools mkarchiso shells out to; they do
# NOT end up in the image. They are installed from ARCH_SNAPSHOT.
#   archiso    - mkarchiso itself
#   grub       - grub-install, required by the 'uefi.grub' bootmode
#   dosfstools - mkfs.fat for the EFI system partition image
#   mtools     - mmd/mcopy, how archiso populates the ESP without loop devices
#   libisoburn - xorriso, writes the final ISO
#   squashfs-tools - mksquashfs for the airootfs image
#   erofs-utils    - alternative airootfs image tool archiso probes for
BUILDER_PACKAGES="archiso grub dosfstools mtools libisoburn squashfs-tools erofs-utils"
