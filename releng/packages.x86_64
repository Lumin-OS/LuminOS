### Graphics stack ###
# mesa is explicit rather than pulled in transitively: Hyprland needs a working
# GL/EGL implementation, and in a VM with no passthrough GPU that means mesa's
# llvmpipe/virgl software path. vulkan-swrast gives the same fallback for
# anything that asks for Vulkan.
mesa
vulkan-swrast
xorg-xwayland
qt5-wayland
qt6-wayland

### Default session: Hyprland ###
# Replaces the i3 + xorg-server stack this profile shipped until now.
# "Session completeness" means all of the following, not just the compositor.
#
# NOTE: no trailing comments on package lines in this file. mkarchiso parses it
# with `sed 's/#.*//'`, which strips the comment but leaves the trailing
# whitespace behind, and the padded string is then handed to pacstrap verbatim.
#
# compositor
hyprland
# polkit agent — without it nothing can escalate privileges from the GUI
hyprpolkitagent
# portal frontend + backends. The GTK backend is what provides a file chooser,
# which the installer needs.
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
# status bar
waybar
# launcher. rofi 2.x is Wayland-native; rofi-wayland was merged upstream and
# that AUR package no longer exists.
rofi
# notifications
mako
# default terminal — Wayland-native and small
foot
# file manager + its mount/trash backend
thunar
gvfs
# replaces xclip
wl-clipboard
# screenshots — also how QA captures boot evidence from inside the session
grim
slurp
brightnessctl
libnotify

### Audio ###
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
alsa-utils
pavucontrol

### Fonts ###
# Deliberately small. The previous set carried eleven nerd-font packages plus
# two Adobe families, which is hundreds of MB of squashfs for a live installer.
# One monospace nerd font covers the terminal and waybar's glyphs; Noto covers
# everything else.
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
ttf-jetbrains-mono-nerd
otf-font-awesome

# ---------------------------------------------------------------------------
# Removed 2026-09-26 — no longer in any Arch repo (verified against core/extra/
# multilib). Each was dropped upstream between Feb 2024 and now; leaving any of
# them here makes the build fail at package resolution.
#   broadcom-wl      -> moved to AUR. airootfs/etc/modprobe.d/broadcom-wl.conf
#                       is kept: it is a blacklist of the in-kernel b43/ssb
#                       drivers and is harmless without the package, but wifi on
#                       old Broadcom chips is now unsupported on the live image.
#   gnu-netcat       -> moved to AUR; replaced above by openbsd-netcat.
#   reiserfsprogs    -> dropped upstream; reiserfs was removed from the kernel
#                       in 6.13, so there is nothing to format or check.
#   wezterm-terminfo -> moved to AUR.
#   nitrogen         -> moved to AUR. Not replaced by a wallpaper daemon: the
#                       session sets misc:background_color instead, because
#                       there is no LuminOS wallpaper art to load yet.
#   ttf-joypixels    -> dropped upstream over licensing.
#
# Removed 2026-09-26 — superseded by the Wayland session:
#   i3-wm i3status i3lock i3blocks picom arandr xterm alacritty xwallpaper
#   xclip xdotool xorg-server xorg-xinit xorg-xclock xorg-xkill xorg-xmessage
#   xorg-xprop xorg-xrdb xorg-xset xorg-xsetroot
#
# Removed 2026-09-26 — fail the "needed to install, or needed on first boot"
# bar and are the two largest rescue payloads:
#   clonezilla partimage
# ---------------------------------------------------------------------------
