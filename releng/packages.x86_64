### Networking ###
# NetworkManager is the live network stack (see
# airootfs/etc/systemd/system/multi-user.target.wants/). It replaces
# systemd-networkd + iwd because it is the only option here with a GUI the
# founder can click to join wifi before running the installer, and because the
# installer needs a network it can query rather than one it has to configure.
networkmanager
network-manager-applet
nm-connection-editor
wpa_supplicant
wireless-regdb
wireless_tools
iw
modemmanager
usbmuxd
systemd-resolvconf
b43-fwcutter
bind
ldns
ethtool
ndisc6
linux-atm
openssh
openbsd-netcat
openconnect
openvpn
vpnc
ppp
pptpclient
rp-pppoe
xl2tpd
wvdial
dnsmasq
darkhttpd
nfs-utils
nbd
open-iscsi
rsync
lftp
tcpdump
nmap

