# The LuminOS live ISO. The installed system is luminos-base and
# luminos-desktop, the same meta-packages Dawn's online install
# pacstraps, so an offline install (a copy of this image) matches an
# online one. Dawn's offline cleanup removes luminos-dawn, luminos-live
# and mkinitcpio-archiso again (luminos-dawn's installer.toml,
# [offline_cleanup]); syslinux and zsh stay.
#
# mkarchiso's format: one package per line; comments are left out.

luminos-base
luminos-desktop
# Also in luminos-base: the repository's signing key, which online
# installs need.
luminos-keyring

# The installer.
luminos-dawn

# The live-only files and tools, from ../luminos-live, built by
# ../build.sh.
luminos-live

# The live boot's initramfs hooks.
mkinitcpio-archiso

# mkarchiso requires syslinux in this list for the BIOS boot modes, so it
# can't be a luminos-live dependency.
syslinux

# root's shell in the live /etc/passwd, which offline installs keep.
zsh
